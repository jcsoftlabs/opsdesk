// Schéma Prisma — OpsDesk
// Référence : IMPLEMENTATION.md §4-6, §15 (SaaS multi-bureaux)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CASHIER
  SUPERVISOR
  ADMIN
}

enum Channel {
  ZELLE
  CASHAPP
  DEPOSIT_USD
  TRANSFER_HTG
}

enum Currency {
  USD
  HTG
}

enum IdType {
  NIF
  NIU
  PASSPORT
  PERMIS
  AUTRE
}

enum TransactionStatus {
  RECEIVED
  VERIFIED
  PAID
  CANCELLED
}

enum AttachmentKind {
  PAYMENT_SCREENSHOT
  ID_DOCUMENT
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementDirection {
  IN
  OUT
}

enum CashMovementReason {
  TRANSFER_PAYOUT
  TRANSFER_FEE_IN
  DEPOSIT_IN
  EXPENSE
  ADJUSTMENT
  OPENING
  CASH_TOPUP
  MOBILE_MONEY_DEPOSIT
  MOBILE_MONEY_TRANSFER
  MOBILE_MONEY_WITHDRAWAL
  OTHER
}

enum MobileMoneyProvider {
  MONCASH
  NATCASH
}

enum MobileMoneyOperationType {
  RETRAIT
  DEPOT
  TRANSFERT
}

enum InvoiceStatus {
  DUE
  PAID
}

// Le "propriétaire" — le client qui paie pour OpsDesk (SaaS multi-bureaux,
// confirmé 2026-08-16). Kmat Supply est la première Organization du système,
// migrée depuis les données mono-tenant existantes.
model Organization {
  id    String @id @default(cuid())
  name  String
  phone String?

  // Tarif mensuel par caisse (bureau) active, facturation par caisse
  // confirmée 2026-08-16. Suivi interne, encaissement manuel pour l'instant.
  billingRatePerBureau Decimal @db.Decimal(18, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  bureaux       Bureau[]
  users         User[]
  pricingRules  PricingRule[]
  referenceRates ReferenceRate[]
  auditLogs     AuditLog[]
  invoices      Invoice[]

  @@map("organizations")
}

// Un bureau physique = une caisse facturable. Un propriétaire peut avoir
// plusieurs bureaux (confirmé 2026-08-16) ; chaque bureau a sa propre caisse
// commune, ses propres clients et transactions.
model Bureau {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now())

  users                 User[]
  clients               Client[]
  transactions          Transaction[]
  attachments           Attachment[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  mobileMoneyOperations MobileMoneyOperation[]

  @@index([organizationId])
  @@map("bureaux")
}

// Trace manuelle de facturation (paiement hors-ligne, virement ou cash) —
// pas d'intégration de paiement automatisée pour l'instant (confirmé
// 2026-08-16). Créée par un PlatformAdmin à chaque période de facturation.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  bureauCount   Int
  ratePerBureau Decimal @db.Decimal(18, 2)
  totalAmount   Decimal @db.Decimal(18, 2)

  status InvoiceStatus @default(DUE)
  paidAt DateTime?
  note   String?

  createdById String
  createdBy   PlatformAdmin @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([organizationId, status])
  @@map("invoices")
}

// Opérateur de la plateforme SaaS (toi), entièrement hors du modèle tenant —
// jamais rattaché à une Organization, session et login séparés (voir
// src/lib/platformAuth.ts) pour qu'une session plateforme ne puisse jamais
// être confondue avec une session tenant.
model PlatformAdmin {
  id           String @id @default(cuid())
  fullName     String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())

  invoices Invoice[]

  @@map("platform_admins")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Nullable : un utilisateur "org-wide" (bureauId = null) gère les bureaux,
  // les utilisateurs et la grille tarifaire de son Organization mais n'ouvre
  // pas personnellement de caisse. Un utilisateur rattaché à un bureau
  // (bureauId défini) opère uniquement dans ce bureau — un caissier/
  // superviseur/admin de bureau appartient à un seul bureau (confirmé
  // 2026-08-16).
  bureauId String?
  bureau   Bureau? @relation(fields: [bureauId], references: [id])

  createdClients        Client[]        @relation("ClientCreatedBy")
  createdTransactions   Transaction[]   @relation("TransactionCreatedBy")
  verifiedTransactions  Transaction[]   @relation("TransactionVerifiedBy")
  paidTransactions      Transaction[]   @relation("TransactionPaidBy")
  cancelledTransactions Transaction[]   @relation("TransactionCancelledBy")
  uploadedAttachments   Attachment[]
  openedCashSessions    CashSession[]
  cashMovements         CashMovement[]
  auditLogs             AuditLog[]
  createdPricingRules   PricingRule[]
  createdReferenceRates ReferenceRate[]
  mobileMoneyOperations MobileMoneyOperation[]

  @@index([organizationId])
  @@index([bureauId])
  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  idType    IdType
  idNumber  String
  createdAt DateTime @default(now())

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  createdById String
  createdBy   User   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  transactions          Transaction[] @relation("TransactionClient")
  collectedTransactions Transaction[] @relation("TransactionCollectedBy")

  @@unique([bureauId, idType, idNumber])
  @@map("clients")
}

// Taux de change de référence du marché, saisi par l'admin (§7.8), utilisé
// pour calculer la marge de change — indépendant du taux appliqué au client
// (PricingRule.exchangeRate). Même logique de versionnement (jamais d'update).
// Scopé par Organization : un propriétaire fixe un taux pour tous ses bureaux.
model ReferenceRate {
  id            String    @id @default(cuid())
  rate          Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, effectiveTo])
  @@map("reference_rates")
}

// Scopée par Organization : la grille tarifaire est définie une fois par le
// propriétaire pour tous ses bureaux (pas d'override par bureau pour
// l'instant — à ajouter plus tard si un client le demande).
model PricingRule {
  id                  String    @id @default(cuid())
  channel             Channel
  payoutCurrency      Currency
  allowed             Boolean
  feePercent          Decimal   @db.Decimal(5, 2)
  exchangeRate        Decimal?  @db.Decimal(10, 4)
  feeBeforeConversion Boolean
  roundingUnit        Decimal   @default(1) @db.Decimal(10, 4)
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, channel, payoutCurrency, effectiveTo])
  @@map("pricing_rules")
}

model Transaction {
  id          String  @id @default(cuid())
  receiptNo   String  @unique @default(dbgenerated("generate_receipt_no()")) @db.VarChar
  channel     Channel
  externalRef String
  senderName  String

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  clientId String
  client   Client @relation("TransactionClient", fields: [clientId], references: [id])

  // Procuration (confirmé 2026-07-28) : la personne qui se présente au
  // guichet et signe le reçu peut différer du bénéficiaire visé par
  // l'expéditeur. Renseigné au moment du paiement (§7.4), pas à la création.
  collectedById String?
  collectedBy   Client? @relation("TransactionCollectedBy", fields: [collectedById], references: [id])

  amountReceived   Decimal  @db.Decimal(18, 2)
  receivedCurrency Currency
  payoutCurrency   Currency

  feePercentApplied   Decimal  @db.Decimal(5, 2)
  exchangeRateApplied Decimal? @db.Decimal(10, 4)
  feeAmount           Decimal  @db.Decimal(18, 2)
  netPayout           Decimal  @db.Decimal(18, 2)

  status TransactionStatus @default(RECEIVED)

  createdById String
  createdBy   User   @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  verifiedById String?
  verifiedBy   User?     @relation("TransactionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  paidById String?
  paidBy   User?     @relation("TransactionPaidBy", fields: [paidById], references: [id])
  paidAt   DateTime?

  cancelledById String?
  cancelledBy   User?     @relation("TransactionCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  importedFromLegacy Boolean @default(false)

  createdAt DateTime @default(now())

  attachments   Attachment[]
  cashMovements CashMovement[]

  @@unique([bureauId, channel, externalRef])
  @@index([bureauId, status, createdAt])
  @@index([clientId])
  @@index([collectedById])
  @@map("transactions")
}

model Attachment {
  id            String         @id @default(cuid())
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  kind          AttachmentKind

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  publicId  String
  secureUrl String
  mimeType  String
  sizeBytes Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@map("attachments")
}

// Caisse commune d'un bureau (pas une caisse par caissier) : les agents qui
// traitent les transactions ne gèrent pas leur propre caisse — ils puisent
// dans la caisse partagée de leur bureau, que seul un ADMIN de ce bureau
// ouvre/ferme, alimentée en cours de journée par des apports de liquidités.
// Un bureau n'a jamais plus d'une caisse OPEN à la fois — voir IMPLEMENTATION.md §7.6.
model CashSession {
  id String @id @default(cuid())

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  openedById String
  openedBy   User   @relation(fields: [openedById], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingUsd Decimal @db.Decimal(18, 2)
  openingHtg Decimal @db.Decimal(18, 2)

  expectedUsd  Decimal? @db.Decimal(18, 2)
  expectedHtg  Decimal? @db.Decimal(18, 2)
  countedUsd   Decimal? @db.Decimal(18, 2)
  countedHtg   Decimal? @db.Decimal(18, 2)
  varianceUsd  Decimal? @db.Decimal(18, 2)
  varianceHtg  Decimal? @db.Decimal(18, 2)
  varianceNote String?

  status CashSessionStatus @default(OPEN)

  transactions          Transaction[]
  cashMovements         CashMovement[]
  mobileMoneyOperations MobileMoneyOperation[]

  @@index([bureauId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  direction CashMovementDirection
  currency  Currency
  amount    Decimal               @db.Decimal(18, 2)
  reason    CashMovementReason

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  mobileMoneyOperationId String?
  mobileMoneyOperation   MobileMoneyOperation? @relation(fields: [mobileMoneyOperationId], references: [id])

  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([cashSessionId])
  @@index([bureauId])
  @@map("cash_movements")
}

// Registre BRH des opérations MonCash/NatCash (cahier obligatoire des agents
// de monnaie mobile), distinct des transferts diaspora : pas de calcul de
// frais (les frais sont fixés par le réseau MonCash/NatCash lui-même, non
// modifiables par l'agent — le gain de l'agent résulte de son contrat avec
// Digicel/Natcom, hors du champ d'OpsDesk). HTG uniquement. Append-only
// comme audit_logs : un cahier ne se corrige pas après coup.
//
// Affecte bien la caisse commune (confirmé 2026-08-16, révision de la
// décision initiale du même jour) : un dépôt ou un transfert fait rentrer du
// cash physique (le client remet l'argent au guichet), un retrait en fait
// sortir. Chaque opération crée donc un CashMovement lié, dans la session de
// caisse ouverte au moment de la saisie — voir §7.9.
model MobileMoneyOperation {
  id            String                    @id @default(cuid())
  provider      MobileMoneyProvider
  operationType MobileMoneyOperationType

  bureauId String
  bureau   Bureau @relation(fields: [bureauId], references: [id])

  // Numéro du client venu au guichet (retrait, dépôt ou transfert).
  clientNumber String

  // Renseigné uniquement pour un TRANSFERT (client du réseau qui envoie à un
  // autre client du même réseau, au guichet).
  destinataireNumber String?

  amount Decimal @db.Decimal(18, 2)

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  cashMovements CashMovement[]

  @@index([bureauId, provider, createdAt])
  @@index([clientNumber])
  @@map("mobile_money_operations")
}

model AuditLog {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  beforeJson Json?
  afterJson  Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
