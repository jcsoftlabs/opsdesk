// Schéma Prisma — OpsDesk, phase 1 (transferts)
// Référence : IMPLEMENTATION.md §4-6

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CASHIER
  SUPERVISOR
  ADMIN
}

enum Channel {
  ZELLE
  CASHAPP
  DEPOSIT_USD
  TRANSFER_HTG
}

enum Currency {
  USD
  HTG
}

enum IdType {
  NIF
  NIU
  PASSPORT
  PERMIS
  AUTRE
}

enum TransactionStatus {
  RECEIVED
  VERIFIED
  PAID
  CANCELLED
}

enum AttachmentKind {
  PAYMENT_SCREENSHOT
  ID_DOCUMENT
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementDirection {
  IN
  OUT
}

enum CashMovementReason {
  TRANSFER_PAYOUT
  TRANSFER_FEE_IN
  DEPOSIT_IN
  EXPENSE
  ADJUSTMENT
  OPENING
  CASH_TOPUP
  OTHER
}

enum MobileMoneyProvider {
  MONCASH
  NATCASH
}

enum MobileMoneyOperationType {
  RETRAIT
  DEPOT
  TRANSFERT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdClients        Client[]        @relation("ClientCreatedBy")
  createdTransactions   Transaction[]   @relation("TransactionCreatedBy")
  verifiedTransactions  Transaction[]   @relation("TransactionVerifiedBy")
  paidTransactions      Transaction[]   @relation("TransactionPaidBy")
  cancelledTransactions Transaction[]   @relation("TransactionCancelledBy")
  uploadedAttachments   Attachment[]
  openedCashSessions    CashSession[]
  cashMovements         CashMovement[]
  auditLogs             AuditLog[]
  createdPricingRules   PricingRule[]
  createdReferenceRates ReferenceRate[]
  mobileMoneyOperations MobileMoneyOperation[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  idType    IdType
  idNumber  String
  createdAt DateTime @default(now())

  createdById String
  createdBy   User   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  transactions          Transaction[] @relation("TransactionClient")
  collectedTransactions Transaction[] @relation("TransactionCollectedBy")

  @@unique([idType, idNumber])
  @@map("clients")
}

// Taux de change de référence du marché, saisi par l'admin (§7.8), utilisé
// pour calculer la marge de change — indépendant du taux appliqué au client
// (PricingRule.exchangeRate). Même logique de versionnement (jamais d'update).
model ReferenceRate {
  id            String    @id @default(cuid())
  rate          Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([effectiveTo])
  @@map("reference_rates")
}

model PricingRule {
  id                  String    @id @default(cuid())
  channel             Channel
  payoutCurrency      Currency
  allowed             Boolean
  feePercent          Decimal   @db.Decimal(5, 2)
  exchangeRate        Decimal?  @db.Decimal(10, 4)
  feeBeforeConversion Boolean
  roundingUnit        Decimal   @default(1) @db.Decimal(10, 4)
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([channel, payoutCurrency, effectiveTo])
  @@map("pricing_rules")
}

model Transaction {
  id          String  @id @default(cuid())
  receiptNo   String  @unique @default(dbgenerated("generate_receipt_no()")) @db.VarChar
  channel     Channel
  externalRef String
  senderName  String

  clientId String
  client   Client @relation("TransactionClient", fields: [clientId], references: [id])

  // Procuration (confirmé 2026-07-28) : la personne qui se présente au
  // guichet et signe le reçu peut différer du bénéficiaire visé par
  // l'expéditeur. Renseigné au moment du paiement (§7.4), pas à la création.
  collectedById String?
  collectedBy   Client? @relation("TransactionCollectedBy", fields: [collectedById], references: [id])

  amountReceived   Decimal  @db.Decimal(18, 2)
  receivedCurrency Currency
  payoutCurrency   Currency

  feePercentApplied   Decimal  @db.Decimal(5, 2)
  exchangeRateApplied Decimal? @db.Decimal(10, 4)
  feeAmount           Decimal  @db.Decimal(18, 2)
  netPayout           Decimal  @db.Decimal(18, 2)

  status TransactionStatus @default(RECEIVED)

  createdById String
  createdBy   User   @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  verifiedById String?
  verifiedBy   User?     @relation("TransactionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  paidById String?
  paidBy   User?     @relation("TransactionPaidBy", fields: [paidById], references: [id])
  paidAt   DateTime?

  cancelledById String?
  cancelledBy   User?     @relation("TransactionCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  importedFromLegacy Boolean @default(false)

  createdAt DateTime @default(now())

  attachments   Attachment[]
  cashMovements CashMovement[]

  @@unique([channel, externalRef])
  @@index([status, createdAt])
  @@index([clientId])
  @@index([collectedById])
  @@map("transactions")
}

model Attachment {
  id            String         @id @default(cuid())
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  kind          AttachmentKind

  publicId  String
  secureUrl String
  mimeType  String
  sizeBytes Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@map("attachments")
}

// Caisse commune (pas une caisse par caissier) : les agents qui traitent les
// transactions ne gèrent pas leur propre caisse — ils puisent dans une caisse
// partagée que seul l'ADMIN ouvre/ferme, alimentée en cours de journée par des
// apports de liquidités (livraison de cash). Voir IMPLEMENTATION.md §7.6.
model CashSession {
  id         String @id @default(cuid())
  openedById String
  openedBy   User   @relation(fields: [openedById], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingUsd Decimal @db.Decimal(18, 2)
  openingHtg Decimal @db.Decimal(18, 2)

  expectedUsd  Decimal? @db.Decimal(18, 2)
  expectedHtg  Decimal? @db.Decimal(18, 2)
  countedUsd   Decimal? @db.Decimal(18, 2)
  countedHtg   Decimal? @db.Decimal(18, 2)
  varianceUsd  Decimal? @db.Decimal(18, 2)
  varianceHtg  Decimal? @db.Decimal(18, 2)
  varianceNote String?

  status CashSessionStatus @default(OPEN)

  transactions  Transaction[]
  cashMovements CashMovement[]

  @@index([status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  direction CashMovementDirection
  currency  Currency
  amount    Decimal               @db.Decimal(18, 2)
  reason    CashMovementReason

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  note String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([cashSessionId])
  @@map("cash_movements")
}

// Registre BRH des opérations MonCash/NatCash (cahier obligatoire des agents
// de monnaie mobile), distinct des transferts diaspora : pas de calcul de
// frais (les frais sont fixés par le réseau MonCash/NatCash lui-même, non
// modifiables par l'agent), pas de mouvement de caisse propre à OpsDesk, HTG
// uniquement. Append-only comme audit_logs : un cahier ne se corrige pas
// après coup. Confirmé par le client (2026-08-16).
model MobileMoneyOperation {
  id            String                    @id @default(cuid())
  provider      MobileMoneyProvider
  operationType MobileMoneyOperationType

  // Numéro du client venu au guichet (retrait, dépôt ou transfert).
  clientNumber String

  // Renseigné uniquement pour un TRANSFERT (client du réseau qui envoie à un
  // autre client du même réseau, au guichet).
  destinataireNumber String?

  amount Decimal @db.Decimal(18, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([clientNumber])
  @@map("mobile_money_operations")
}

model AuditLog {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String

  beforeJson Json?
  afterJson  Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
